        "\n",
        "from sklearn.metrics import (\n",
        "    log_loss,\n",
        "    brier_score_loss,\n",
        "    roc_auc_score\n",
        ")\n",
        "import numpy as np\n",
        "\n",
        "X_test = test[features]\n",
        "y_test = test[target]\n",
        "\n",
        "# Estimated probability that each shot goes in\n",
        "probabilities = model.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# A simple baseline: predict the training-set shooting rate\n",
        "baseline_probability = train[target].mean()\n",
        "\n",
        "model_log_loss = log_loss(y_test, probabilities)\n",
        "\n",
        "model_brier = brier_score_loss(y_test, probabilities)\n",
        "\n",
        "baseline_log_loss = log_loss(\n",
        "    y_test,\n",
        "    np.full(len(y_test), baseline_probability),\n",
        "    labels=[0, 1]\n",
        ")\n",
        "\n",
        "baseline_brier = brier_score_loss(\n",
        "    y_test,\n",
        "    np.full(len(y_test), baseline_probability)\n",
        ")\n",
        "\n",
        "print(\"Test shots:\", len(y_test))\n",
        "print(\"Actual test shooting rate:\", round(y_test.mean(), 4))\n",
        "print(\"Model log loss:\", round(model_log_loss, 4))\n",
        "print(\"Baseline log loss:\", round(baseline_log_loss, 4))\n",
        "print(\"Model Brier score:\", round(model_brier, 4))\n",
        "print(\"Baseline Brier score:\", round(baseline_brier, 4))\n",
        "\n",
        "if y_test.nunique() == 2:\n",
        "    print(\n",
        "        \"Model ROC-AUC:\",\n",
        "        round(roc_auc_score(y_test, probabilities), 4)\n",
        "    )\n",
        "else:\n",
        "    print(\"ROC-AUC unavailable: the test set has only one outcome class.\")\n"
