        "\n",
        "import pandas as pd\n",
        "\n",
        "# Group shots into distance ranges\n",
        "df[\"DISTANCE_GROUP\"] = pd.cut(\n",
        "    df[\"SHOT_DISTANCE\"],\n",
        "    bins=[-1, 4, 8, 16, 24, 100],\n",
        "    labels=[\n",
        "        \"0-4 ft\",\n",
