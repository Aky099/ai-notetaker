      "source": [
        "\n",
        "from sklearn.model_selection import GroupShuffleSplit\n",
        "\n",
        "# Keep entire games together rather than splitting individual shots\n",
        "splitter = GroupShuffleSplit(\n",
        "    n_splits=1,\n",
        "    test_size=0.20,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "train_idx, test_idx = next(\n",
        "    splitter.split(\n",
        "        model_df,\n",
        "        model_df[target],\n",
        "        groups=model_df[\"GAME_ID\"]\n",
        "    )\n",
        ")\n",
        "\n",
        "train = model_df.iloc[train_idx].copy()\n",
        "test = model_df.iloc[test_idx].copy()\n",
        "\n",
        "print(\"Training shots:\", len(train))\n",
        "print(\"Testing shots:\", len(test))\n",
        "\n",
        "print(\"Training games:\", train[\"GAME_ID\"].nunique())\n",
        "print(\"Testing games:\", test[\"GAME_ID\"].nunique())\n"
      ],
