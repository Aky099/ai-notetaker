        "        \"9-16 ft\",\n",
        "        \"17-24 ft\",\n",
        "        \"25+ ft\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "# Calculate shooting percentage for each group\n",
        "distance_analysis = (\n",
        "    df.groupby(\"DISTANCE_GROUP\", observed=False)\n",
        "    .agg(\n",
        "        Total_Shots=(\"SHOT_MADE_FLAG\", \"count\"),\n",
        "        Shots_Made=(\"SHOT_MADE_FLAG\", \"sum\"),\n",
        "        Shooting_Percentage=(\"SHOT_MADE_FLAG\", \"mean\")\n",
        "    )\n",
        ")\n",
        "\n",
        "distance_analysis[\"Shooting_Percentage\"] *= 100\n",
        "\n",
        "display(distance_analysis.round(2))\n"
